{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "http-status-codes": ["node_modules/http-status-codes/build/cjs/index.d.ts"]
    }
  },
  "include": ["src/**/*", "index.js", "swagger.js"],
  "exclude": ["node_modules"]
}
